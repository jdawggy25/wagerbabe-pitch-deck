---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-container">
    <div class="footer-grid">
      <div class="footer-brand">
        <span class="footer-logo">WAGER BABE</span>
        <p class="footer-tagline">
          The Modern Pay-Per-Head Platform.<br/>
          Your Book. Smarter.
        </p>
      </div>

      <div class="footer-section">
        <h3 class="footer-heading">Platform</h3>
        <ul class="footer-links">
          <li><span>Full Sportsbook</span></li>
          <li><span>Live In-Game Betting</span></li>
          <li><span>Automated Grading</span></li>
          <li><span>Smart Reports</span></li>
        </ul>
      </div>

      <div class="footer-section">
        <h3 class="footer-heading">Technology</h3>
        <ul class="footer-links">
          <li><span>FastAPI Backend</span></li>
          <li><span>Next.js 15 + React 19</span></li>
          <li><span>Supabase</span></li>
          <li><span>Enterprise Security</span></li>
        </ul>
      </div>

      <div class="footer-section">
        <h3 class="footer-heading">Investment</h3>
        <ul class="footer-links">
          <li><span>Tier 1: $50,000</span></li>
          <li><span>Tier 2: $35,000</span></li>
          <li><span>Tier 3: $25,000</span></li>
          <li><span>Tier 4: $15,000</span></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="footer-copyright">
        &copy; {year} WagerBabe. All rights reserved.
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-border);
    padding: var(--space-12) var(--space-4) var(--space-8);
    margin-top: auto;
  }

  @media (min-width: 768px) {
    .footer {
      padding: var(--space-16) var(--space-8) var(--space-10);
    }
  }

  .footer-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-10);
    margin-bottom: var(--space-10);
    padding-bottom: var(--space-10);
    border-bottom: 1px solid var(--color-border);
  }

  @media (min-width: 640px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-12);
    }
  }

  @media (min-width: 1024px) {
    .footer-grid {
      grid-template-columns: 1.5fr 1fr 1fr 1fr;
      gap: var(--space-12);
    }
  }

  .footer-brand {
    max-width: 280px;
  }

  .footer-logo {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--color-primary);
    display: block;
    margin-bottom: var(--space-3);
  }

  .footer-tagline {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .footer-heading {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 500;
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: var(--space-4);
  }

  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-links li {
    margin-bottom: var(--space-2);
  }

  .footer-links span {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
  }

  .footer-bottom {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .footer-copyright {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 640px) {
    .footer-tagline {
      font-size: 0.875rem;
    }
  }
</style>
